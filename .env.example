# ── Backend ─────────────────────────────────────────────────────
APP_SECRET=               # Session-JWT signing key — any strong random value (e.g. openssl rand -hex 32)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Supabase (rtm-data-warehouse, server-side only) ─────────────
SUPABASE_URL=             # e.g. https://<project-ref>.supabase.co
# FIX 16: production uses the SECRET key (sb_secret_...) — the anon key is in
# public git history. Anon remains accepted as the local-dev fallback only;
# at least one of the two must be set.
SUPABASE_SERVICE_KEY=     # sb_secret_... — production; server-side only, never ship to client
SUPABASE_ANON_KEY=        # sb_publishable_... — local-dev fallback

# ── Weather (optional — the Weather tab degrades without it) ────
BALLPARKPAL_API_KEY=

# ── Game odds (optional — Gamecenter moneyline/runline/total degrades to dashes without it) ──
ODDS_API_KEY=             # The Odds API v4 key — game odds ONLY (h2h/spreads/totals), never player props

# Auth is email + password (FIX 12). One owner account is seeded by migration
# 0002 with a NULL password hash; on first server start a one-time setup link
# is printed to the console (single use, 60-minute expiry). Lost or expired?
# Restart the server, or run: npm run setup-url
